# Postgres
POSTGRES_USER=kitchen
POSTGRES_PASSWORD=kitchen
POSTGRES_DB=kitchen
POSTGRES_HOST_PORT=55432

# Redis
REDIS_HOST_PORT=56379
REDIS_URL=redis://redis:6379/0

# RabbitMQ
RABBITMQ_USER=kitchen
RABBITMQ_PASSWORD=kitchen
RABBITMQ_HOST_PORT=55672
RABBITMQ_MGMT_HOST_PORT=15672
RABBITMQ_URL=amqp://kitchen:kitchen@rabbitmq:5672/

# Общее для сервисов, подключающихся к БД
DATABASE_URL=postgres://kitchen:kitchen@postgres:5432/kitchen?sslmode=disable

# kitchen-api
HTTP_ADDR=:8080
API_HOST_PORT=8080
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=10s
OPENAPI_PATH=/app/openapi.yaml
# Разрешённые Origin'ы для CORS через запятую. Пустое значение отключает CORS.
CORS_ORIGINS=http://localhost:3000
# Валидация каждого запроса против api/openapi.yaml через kin-openapi.
# true — спека и код не могут разъехаться. false — валидация только в сервисе.
OPENAPI_VALIDATE=true

# migrate
MIGRATIONS_DIR=/app/migrations

# restaurant-sample
API_BASE_URL=http://api:8080
RESTAURANT_KEY=demo-restaurant-key
# Идентификатор заведения, чью очередь слушает sample (routing key
# orders.<id>.*). Совпадает с id из seed-миграции.
RESTAURANT_ID=11111111-1111-1111-1111-111111111111
# POLL_INTERVAL используется только в fallback-режиме (пустой RABBITMQ_URL).
POLL_INTERVAL=5s
COOK_DELAY_MS=3000
